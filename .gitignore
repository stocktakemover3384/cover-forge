# ── 系统噪声 ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── 编辑器 / IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── 测试产物（运行 tests/qa.mjs 与 tests/verify.mjs 后生成）──────────────
# 注意：.gitignore 不支持行尾注释 —— 注释必须独占一行，否则整行会被当成模式。
# 用通配一次覆盖所有产物目录：output/、output-verify/、以及临时调试目录
# （如 output-designer-*/），避免以后每加一个目录都要回来改一次。
tests/output*/
# 按 PID 隔离的临时运行脚本与产物
tests/_*.mjs
tests/.qa-iso-*.mjs
tests/downloads/
tests/fixtures/

# 注意：tests/node_modules/ 忽略，但 tests/package.json 与
# tests/package-lock.json 要入库 —— 让 `npm ci` 能复现出同一份 playwright-core。
tests/node_modules/

# ── 通用 ─────────────────────────────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
*.log
npm-debug.log*
.env
.env.local

# 测试依赖的 lockfile 需要入库（覆盖上面的通用规则）
!tests/package-lock.json

# 本地临时图片，别误提交
/tmp-*
scratch/
