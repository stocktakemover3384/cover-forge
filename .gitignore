# ── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Test artefacts (created by tests/qa.mjs and tests/verify.mjs) ────────
# NOTE: .gitignore does not support trailing comments — a comment must occupy
# its own line, otherwise the whole line is treated as a pattern.
# One wildcard covers every artefact directory: output/, output-verify/ and
# ad-hoc debug dirs (e.g. output-designer-*/), so new ones need no edit here.
tests/output*/
# PID-isolated temporary run scripts and artefacts
tests/_*.mjs
tests/.qa-iso-*.mjs
tests/downloads/
tests/fixtures/

# tests/node_modules/ is ignored, but tests/package.json and
# tests/package-lock.json ARE committed — so `npm ci` reproduces the exact
# playwright-core build used by the test suites.
tests/node_modules/

# ── Generic ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
*.log
npm-debug.log*
.env
.env.local

# The test lockfile must be committed (overrides the generic rule above)
!tests/package-lock.json

# Local scratch images — do not commit by accident
/tmp-*
scratch/
